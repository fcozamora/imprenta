[mysqld]
# ---- Memoria ----
# Regla práctica: 50-60% de la RAM que le asignes al contenedor.
# Con 16 GB en la Mac Mini M4, 2G es holgado para este volumen de datos.
innodb_buffer_pool_size         = 2G
innodb_buffer_pool_instances    = 2
innodb_log_file_size            = 256M
innodb_redo_log_capacity        = 512M

# ---- Escritura / durabilidad ----
innodb_flush_log_at_trx_commit  = 1
innodb_flush_method             = O_DIRECT
innodb_file_per_table           = ON

# ---- Concurrencia ----
max_connections                 = 200
innodb_thread_concurrency       = 0
table_open_cache                = 4000

# ---- Consultas lentas (para afinar índices después) ----
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/slow.log
long_query_time                 = 0.5
log_queries_not_using_indexes   = 0

# ---- Búsquedas FULLTEXT: permitir palabras de 2 letras ----
innodb_ft_min_token_size        = 2

# ---- Modo estricto ----
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
